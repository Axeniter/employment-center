<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmploymentApp.Pages.VacancyDetailEmployerPage"
             Title="Детали вакансии">

    <Grid RowDefinitions="*">

        <!-- Основное содержимое -->
        <Grid ColumnDefinitions="250,*" RowDefinitions="*">

            <!-- Левая панель -->
            <Border Grid.Column="0" 
                    Grid.Row="0"
                    Padding="15"
                    BackgroundColor="#e8e8e8"
                    StrokeThickness="0">

                <Grid RowDefinitions="Auto,*,Auto">

                    <VerticalStackLayout Grid.Row="0"></VerticalStackLayout>

                    <!-- Количество откликов -->
                    <VerticalStackLayout Grid.Row="1" Spacing="15" VerticalOptions="Start">
                        <Frame BorderColor="#999" 
                               CornerRadius="8" 
                               Padding="15"
                               HasShadow="False"
                               BackgroundColor="White">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label Text="{Binding Responses.Count}" 
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="Black"
                                       HorizontalOptions="Center"/>
                                <Label Text="откликов получено"
                                       FontSize="14"
                                       TextColor="Gray"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Кнопка назад -->
                    <Button Grid.Row="2"
                            Text="НАЗАД"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="#e0e0e0"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Padding="10,8"/>

                </Grid>

            </Border>

            <ScrollView Grid.Column="1" 
                        Grid.Row="0">

                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- Заголовок вакансии -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding VacancyTitle}" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="Black"
                               LineBreakMode="WordWrap"/>

                        <Label Text="{Binding SalaryRange}" 
                               FontSize="18" 
                               TextColor="Green" 
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <!-- Локация и тип занятости -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Место работы" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Label Text="{Binding WorkLocation}" 
                               FontSize="16" 
                               TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Тип занятости -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Тип занятости" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Label Text="{Binding EmploymentType}" 
                               FontSize="16"
                               TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Требования -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Требования" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Frame BorderColor="#e0e0e0" 
                               CornerRadius="10" 
                               Padding="15"
                               HasShadow="False"
                               BackgroundColor="White">

                            <Label Text="{Binding RequirementsText}" 
                                   FontSize="14"
                                   TextColor="Black"
                                   LineBreakMode="WordWrap"/>

                        </Frame>
                    </VerticalStackLayout>

                    <!-- Описание вакансии -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Описание вакансии" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Frame BorderColor="#e0e0e0" 
                               CornerRadius="10" 
                               Padding="15"
                               HasShadow="False"
                               BackgroundColor="White">

                            <Label Text="{Binding VacancyDescription}" 
                                   FontSize="14"
                                   TextColor="Black"
                                   LineBreakMode="WordWrap"/>

                        </Frame>
                    </VerticalStackLayout>

                    <!-- Разделитель -->
                    <BoxView HeightRequest="2" 
                             BackgroundColor="#e0e0e0" 
                             Margin="0,20"/>

                    <!-- Отклики на вакансию -->
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Отклики на вакансию" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <!-- Список откликов -->
                        <CollectionView ItemsSource="{Binding Responses}"
                                        SelectionMode="None"
                                        IsVisible="{Binding HasResponses}">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="0,8">
                                        <Frame BorderColor="#e0e0e0" 
                                               CornerRadius="10" 
                                               Padding="15"
                                               HasShadow="False"
                                               BackgroundColor="White">

                                            <VerticalStackLayout Spacing="12">

                                                <!-- Имя и статус -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding FullName}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="Black"
                                                           VerticalOptions="Center"/>

                                                    <Frame Grid.Column="1"
                                                           BorderColor="{Binding StatusColor}"
                                                           BackgroundColor="Transparent"
                                                           CornerRadius="8"
                                                           Padding="10,5"
                                                           HasShadow="False">
                                                        <Label Text="{Binding StatusText}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding StatusColor}"/>
                                                    </Frame>
                                                </Grid>

                                                <!-- Контактный номер -->
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Label Grid.Column="0"
                                                           Text="☎"
                                                           FontSize="14"
                                                           TextColor="#666"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding PhoneNumber}"
                                                           FontSize="14"
                                                           TextColor="#666"/>
                                                </Grid>

                                                <!-- О себе -->
                                                <VerticalStackLayout Spacing="5" IsVisible="{Binding About, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                                                    <Label Text="О себе:"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#999"/>
                                                    <Label Text="{Binding About}"
                                                           FontSize="13"
                                                           TextColor="#333"
                                                           LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>

                                                <!-- Навыки -->
                                                <VerticalStackLayout Spacing="5" IsVisible="{Binding SkillsText, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                                                    <Label Text="Навыки:"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#999"/>
                                                    <Label Text="{Binding SkillsText}"
                                                           FontSize="13"
                                                           TextColor="#333"
                                                           LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>

                                                <!-- Кнопки принять/отклонить -->
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                                                    <Button Grid.Column="0"
                                                            Text="✓ Принять"
                                                            BackgroundColor="#4CAF50"
                                                            TextColor="White"
                                                            FontSize="14"
                                                            Padding="15,8"
                                                            CornerRadius="8"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AcceptResponseCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            IsEnabled="{Binding Status, StringFormat='{0:pending}'}"/>

                                                    <Button Grid.Column="1"
                                                            Text="✕ Отклонить"
                                                            BackgroundColor="#F44336"
                                                            TextColor="White"
                                                            FontSize="14"
                                                            Padding="15,8"
                                                            CornerRadius="8"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RejectResponseCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            IsEnabled="{Binding Status, StringFormat='{0:pending}'}"/>
                                                </Grid>

                                            </VerticalStackLayout>

                                        </Frame>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>

                        <!-- Сообщение если нет откликов -->
                        <Label Text="Нет откликов на эту вакансию"
                               FontSize="14"
                               TextColor="Gray"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding HasResponses, Converter={StaticResource InvertedBoolConverter}}"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
