<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmploymentApp.Pages.VacancyDetailPage"
             Title="VacancyDetailPage">

    <Grid RowDefinitions="*">

        <!-- Основное содержимое -->
        <Grid ColumnDefinitions="250,*" RowDefinitions="*">

            <!-- Левая панель (серая область) -->
            <Border Grid.Column="0" 
                    Grid.Row="0"
                    Padding="15"
                    BackgroundColor="#e8e8e8"
                    StrokeThickness="0">

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Кнопка откликнуться (только для applicant) -->
                    <VerticalStackLayout Grid.Row="0" Spacing="15">
                        <Button Text="{Binding ApplyButtonText}"
                                IsEnabled="{Binding IsApplicant}"
                                Command="{Binding ApplyToVacancyCommand}"
                                BackgroundColor="{Binding IsApplicant, StringFormat='{0:CHANGE_THIS}'}"
                                TextColor="Black"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="10,10"
                                IsVisible="{Binding IsApplicant}"/>

                        <!-- Если уже откликнулся -->
                        <Label Text="Вы уже откликнулись на эту вакансию"
                               IsVisible="{Binding HasApplied}"
                               FontSize="12"
                               TextColor="Green"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"/>
                        
                    </VerticalStackLayout>

                    <!-- Информация о работодателе (в середине) -->
                    <VerticalStackLayout Grid.Row="1" 
                                        Spacing="15"
                                        VerticalOptions="Center"
                                        Padding="0,20">

                        <Label Text="О работодателе" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <VerticalStackLayout BackgroundColor="White" 
                                            Padding="10"
                                            Spacing="8"
                                            >

                            <Label Text="Информация о работодателе"
                                   FontSize="12"
                                   TextColor="#999999"
                                   HorizontalTextAlignment="Center"/>

                            <!-- Здесь можно добавить информацию о работодателе позже -->
                            <Label Text="ID работодателя:"
                                   FontSize="11"
                                   TextColor="Black"/>
                            <Label Text="{Binding EmployerId}"
                                   FontSize="10"
                                   TextColor="#666666"
                                   LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- Кнопка назад (в конце) -->
                    <Button Grid.Row="2"
                            Text="НАЗАД"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="#e0e0e0"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Padding="10,8"/>

                </Grid>

            </Border>

            <!-- Правая панель со скроллом (детали вакансии) -->
            <ScrollView Grid.Column="1" 
                        Grid.Row="0">

                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- Заголовок вакансии -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Title}" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="Black"
                               LineBreakMode="WordWrap"/>

                        <Label Text="{Binding SalaryRange}" 
                               FontSize="18" 
                               TextColor="Green" 
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <!-- Локация и удалённость -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Место работы" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               TextColor="Black"/>
                        <Label Text="{Binding WorkLocation}" 
                               FontSize="14" 
                               TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Теги -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Теги" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <CollectionView ItemsSource="{Binding Tags}" 
                                        SelectionMode="None" 
                                        HeightRequest="50">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" 
                                            StrokeThickness="0" 
                                            StrokeShape="RoundRectangle 15" 
                                            BackgroundColor="#9dfca8">
                                        <Label Text="{Binding .}" 
                                               FontSize="12"
                                               TextColor="Black"
                                               FontAttributes="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Описание вакансии -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Описание вакансии" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Frame BorderColor="#e0e0e0" 
                               CornerRadius="10" 
                               Padding="15"
                               HasShadow="False"
                               BackgroundColor="White">

                            <Label Text="{Binding Description}" 
                                   FontSize="14"
                                   TextColor="Black"
                                   LineBreakMode="WordWrap"/>

                        </Frame>
                    </VerticalStackLayout>

                    <!-- Разделитель -->
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#e0e0e0" 
                             Margin="0,10"/>

                    <!-- Дополнительная информация -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Дополнительная информация" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" RowSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Тип занятости:"
                                   FontSize="12"
                                   TextColor="Black"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding IsRemote}"
                                   FontSize="12"
                                   TextColor="Gray"/>

                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>