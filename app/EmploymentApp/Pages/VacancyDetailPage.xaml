<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmploymentApp.Pages.VacancyDetailPage"
             Title="VacancyDetailPage">

    <Grid RowDefinitions="*">

        <!-- Основное содержимое -->
        <Grid ColumnDefinitions="250,*" RowDefinitions="*">

            <!-- Левая панель -->
            <Border Grid.Column="0" 
                    Grid.Row="0"
                    Padding="15"
                    BackgroundColor="#e8e8e8"
                    StrokeThickness="0">

                <Grid RowDefinitions="Auto,*,Auto">

                    <VerticalStackLayout Grid.Row="0"></VerticalStackLayout>
                    
                    <!-- Кнопка откликнуться (только для applicant) -->
                    <VerticalStackLayout Grid.Row="1" Spacing="15">
                        <Button Text="{Binding ApplyButtonText}"
                                IsEnabled="{Binding IsApplicant}"
                                Command="{Binding ApplyToVacancyCommand}"
                                BackgroundColor="{Binding IsApplicant, StringFormat='{0:CHANGE_THIS}'}"
                                TextColor="Black"
                                FontAttributes="Bold"
                                HeightRequest="100"
                                CornerRadius="8"
                                Padding="10,10"
                                IsVisible="{Binding IsApplicant}"/>

                        <!-- Если уже откликнулся -->
                        <Label Text="Вы уже откликнулись на эту вакансию"
                               IsVisible="{Binding HasApplied}"
                               FontSize="14"
                               TextColor="Green"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"/>

                    </VerticalStackLayout>

                    <!-- Кнопка назад -->
                    <Button Grid.Row="2"
                            Text="НАЗАД"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="#e0e0e0"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Padding="10,8"/>

                </Grid>

            </Border>

            <ScrollView Grid.Column="1" 
                        Grid.Row="0">

                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- Заголовок вакансии -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Title}" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="Black"
                               LineBreakMode="WordWrap"/>

                        <Label Text="{Binding SalaryRange}" 
                               FontSize="18" 
                               TextColor="Green" 
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <!-- Локация и удалённость -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Место работы" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Label Text="{Binding WorkLocation}" 
                               FontSize="16" 
                               TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Теги -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Теги" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Label Text="{Binding TagsAsString}" 
                               FontSize="16"
                               TextColor="Gray"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <!-- Описание вакансии -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Описание вакансии" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Frame BorderColor="#e0e0e0" 
                               CornerRadius="10" 
                               Padding="15"
                               HasShadow="False"
                               BackgroundColor="White">

                            <Label Text="{Binding Description}" 
                                   FontSize="14"
                                   TextColor="Black"
                                   LineBreakMode="WordWrap"/>

                        </Frame>
                    </VerticalStackLayout>

                    <!-- Разделитель -->
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#e0e0e0" 
                             Margin="0,10"/>

                    <!-- Дополнительная информация -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Дополнительная информация" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" RowSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Тип занятости:"
                                   FontSize="16"
                                   TextColor="Black"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding WorkType}"
                                   FontSize="14"
                                   TextColor="Gray"/>

                        </Grid>
                    </VerticalStackLayout>

                    <!-- Разделитель -->
                    <BoxView HeightRequest="2" 
                             BackgroundColor="#e0e0e0" 
                             Margin="0,20"/>

                    <!-- Информация о работодателе -->
                    <VerticalStackLayout Spacing="15">
                        <Label Text="О компании" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Frame BorderColor="#e0e0e0" 
                               CornerRadius="10" 
                               Padding="20"
                               HasShadow="False"
                               BackgroundColor="White">

                            <VerticalStackLayout Spacing="15">

                                <!-- Название компании -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Название компании" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="Black"/>
                                    <Label Text="{Binding CompanyName}" 
                                           FontSize="16"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>

                                <!-- Описание компании -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Описание" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="Black"/>
                                    <Label Text="{Binding CompanyDescription}" 
                                           FontSize="15"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>

                                <!-- Контакт -->
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Контакт" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="Black"/>
                                    <Label Text="{Binding CompanyContact}" 
                                           FontSize="15"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Frame>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
